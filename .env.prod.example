# ─── casedock production (Docker / Hetzner / Caddy) ──────────────────────────
# Copy to .env on the production host and fill real values.
# Used by docker-compose.yml for both variable substitution and container env.

# Django core
DJANGO_SETTINGS_MODULE=config.settings.prod
# Generate with: uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=__GENERATE__
DEBUG=false

# Hosts / CSRF — replace casedock.example.com with your real domain.
ALLOWED_HOSTS=casedock.example.com
CSRF_TRUSTED_ORIGINS=https://casedock.example.com

# Postgres — consumed by docker-compose.yml (postgres service init + DATABASE_URL).
POSTGRES_DB=casedock
POSTGRES_USER=casedock
POSTGRES_PASSWORD=__STRONG_PASSWORD__

# Email (SMTP). Example values for Resend; adapt for SendGrid/SES/Mailgun.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=__SMTP_API_KEY__
DEFAULT_FROM_EMAIL=Casedock <noreply@casedock.example.com>

# Optional: override the shared Caddy network name if your host uses a different one.
# CADDY_NETWORK=caddy_net
